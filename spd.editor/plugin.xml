<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- .spd ファイルをテキスト系のコンテンツタイプとして登録 -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="work.powercampus.spd.contentType"
            name="SPD File"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="spd"
            default-charset="UTF-8"
            priority="normal">
      </content-type>
   </extension>

   <!-- SPDエディタ本体 -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="work.powercampus.spd.editor.SpdEditor"
            name="SPD Editor"
            class="work.powercampus.spd.editor.SpdEditor"
            extensions="spd"
            default="true">
         <contentTypeBinding contentTypeId="work.powercampus.spd.contentType"/>
      </editor>
   </extension>

   <!-- 新規 SPD ファイル作成ウィザード（ファイル → 新規 → その他 → SPD） -->
   <extension point="org.eclipse.ui.newWizards">
      <category
            id="work.powercampus.spd.category"
            name="SPD">
      </category>
      <wizard
            id="work.powercampus.spd.editor.SpdNewFileWizard"
            name="SPD ファイル"
            category="work.powercampus.spd.category"
            class="work.powercampus.spd.editor.SpdNewFileWizard">
         <description>言語を選んで、新しい SPD ファイル（.spd）を作成します</description>
      </wizard>
   </extension>

   <!-- Java・リソース パースペクティブでは「ファイル → 新規」に直接表示する -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
         <newWizardShortcut id="work.powercampus.spd.editor.SpdNewFileWizard"/>
      </perspectiveExtension>
      <perspectiveExtension targetID="org.eclipse.ui.resourcePerspective">
         <newWizardShortcut id="work.powercampus.spd.editor.SpdNewFileWizard"/>
      </perspectiveExtension>
   </extension>

</plugin>
