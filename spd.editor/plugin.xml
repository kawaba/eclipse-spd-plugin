<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- 表示する文言は plugin.properties（英語）・plugin_ja.properties（日本語）の %キー -->

   <!-- .spd ファイルをテキスト系のコンテンツタイプとして登録 -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="work.powercampus.spd.contentType"
            name="%contentType.name"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="spd"
            default-charset="UTF-8"
            priority="normal">
      </content-type>
   </extension>

   <!-- SPDエディタ本体（.spd ファイルを開いたとき） -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="work.powercampus.spd.editor.SpdEditor"
            name="%editor.name"
            icon="icons/spd.png"
            class="work.powercampus.spd.editor.SpdEditor"
            extensions="spd"
            default="true">
         <contentTypeBinding contentTypeId="work.powercampus.spd.contentType"/>
      </editor>
   </extension>

   <!-- SPD エディタのビュー（ファイルを作らずに使う。ウィンドウ → ビューの表示 → その他 → SPD） -->
   <extension point="org.eclipse.ui.views">
      <category
            id="work.powercampus.spd.viewCategory"
            name="SPD">
      </category>
      <view
            id="work.powercampus.spd.editor.SpdView"
            name="%view.name"
            icon="icons/spd.png"
            category="work.powercampus.spd.viewCategory"
            class="work.powercampus.spd.editor.SpdView"
            allowMultiple="false">
      </view>
   </extension>

   <!-- 新規 SPD ファイル作成ウィザード（ファイル → 新規 → その他 → SPD） -->
   <extension point="org.eclipse.ui.newWizards">
      <category
            id="work.powercampus.spd.category"
            name="SPD">
      </category>
      <wizard
            id="work.powercampus.spd.editor.SpdNewFileWizard"
            name="%wizard.name"
            icon="icons/spd.png"
            category="work.powercampus.spd.category"
            class="work.powercampus.spd.editor.SpdNewFileWizard">
         <description>%wizard.description</description>
      </wizard>
   </extension>

   <!-- フォントのフォルダを開くコマンド（web/fonts/ をエクスプローラーで開く） -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="work.powercampus.spd.openFontFolder"
            name="%command.openFontFolder.name"
            description="%command.openFontFolder.description"
            defaultHandler="work.powercampus.spd.editor.OpenFontFolderHandler">
      </command>
   </extension>

   <!-- メニュー「SPD」とツールバーのボタン（表示・新規は Eclipse 標準のコマンドを使う） -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="work.powercampus.spd.menu" label="SPD">
            <command
                  commandId="org.eclipse.ui.views.showView"
                  label="%menu.openView"
                  icon="icons/spd.png"
                  style="push">
               <parameter name="org.eclipse.ui.views.showView.viewId"
                     value="work.powercampus.spd.editor.SpdView"/>
            </command>
            <command
                  commandId="org.eclipse.ui.newWizard"
                  label="%menu.newFile"
                  style="push">
               <parameter name="newWizardId"
                     value="work.powercampus.spd.editor.SpdNewFileWizard"/>
            </command>
            <separator name="font" visible="true"/>
            <command
                  commandId="work.powercampus.spd.openFontFolder"
                  label="%menu.openFontFolder"
                  style="push">
            </command>
         </menu>
      </menuContribution>
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="work.powercampus.spd.toolbar" label="SPD">
            <command
                  commandId="org.eclipse.ui.views.showView"
                  icon="icons/spd.png"
                  tooltip="%menu.openView"
                  style="push">
               <parameter name="org.eclipse.ui.views.showView.viewId"
                     value="work.powercampus.spd.editor.SpdView"/>
            </command>
         </toolbar>
      </menuContribution>
   </extension>

   <!-- Java・リソース パースペクティブ：
        SPD ビューは「問題」ビューと同じ場所（下部・横長）に開く。
        「ファイル → 新規」「ウィンドウ → ビューの表示」に直接表示する -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
         <view id="work.powercampus.spd.editor.SpdView"
               relative="org.eclipse.ui.views.ProblemView"
               relationship="stack"
               visible="false"/>
         <viewShortcut id="work.powercampus.spd.editor.SpdView"/>
         <newWizardShortcut id="work.powercampus.spd.editor.SpdNewFileWizard"/>
      </perspectiveExtension>
      <perspectiveExtension targetID="org.eclipse.ui.resourcePerspective">
         <view id="work.powercampus.spd.editor.SpdView"
               relative="org.eclipse.ui.views.ProblemView"
               relationship="stack"
               visible="false"/>
         <viewShortcut id="work.powercampus.spd.editor.SpdView"/>
         <newWizardShortcut id="work.powercampus.spd.editor.SpdNewFileWizard"/>
      </perspectiveExtension>
   </extension>

</plugin>
